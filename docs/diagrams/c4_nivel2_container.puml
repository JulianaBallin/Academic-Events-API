@startuml c4_nivel2_container

' usa a biblioteca C4 embutida no PlantUML (stdlib, não precisa de internet)
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title [Nível 2] Containers - AcademicEvents Solution

Person(usuario, "Usuário / Organizador", "Acessa a API via Swagger,\nPostman ou aplicação cliente.")

' projetos da nossa solution .NET
Container(apiProj, "AcademicEvents.API", "ASP.NET Core Web API", "Camada de entrada da aplicação.\nControllers, configuração de autenticação,\nSwagger, middlewares e Program.cs.")

Container(appProj, "AcademicEvents.Application", "Class Library C#", "Camada de aplicação.\nDTOs, services, interfaces de serviço,\nvalidações de entrada e casos de uso.")

Container(domainProj, "AcademicEvents.Domain", "Class Library C#", "Camada de domínio.\nEntidades, enums e regras essenciais\ndo problema, sem dependência de framework.")

Container(infraProj, "AcademicEvents.Infrastructure", "Class Library C#", "Camada de infraestrutura.\nDbContext, repositories, migrations\ne configurações do EF Core.")

Container(excProj, "AcademicEvents.Exceptions", "Class Library C#", "Exceções customizadas e modelos\nde erro padronizados para a API.")

' banco de dados fora da solution
ContainerDb(db, "PostgreSQL 15", "Banco de Dados Relacional", "Armazena todos os dados da plataforma.\nRoda em container Docker (docker-compose).")

' fluxo de dependências entre os projetos
Rel(usuario, apiProj, "Requisições HTTP/HTTPS", "JSON / Bearer Token")
Rel(apiProj, appProj, "Chama services para executar\nregras de negócio", ".NET / DI")
Rel(apiProj, infraProj, "Registra repositories no DI\ncontainer via extension method", ".NET / DI")
Rel(apiProj, excProj, "Captura e trata exceções\ncustomizadas", ".NET")
Rel(appProj, domainProj, "Usa entidades, enums e\ninterfaces de repository", ".NET")
Rel(infraProj, domainProj, "Implementa interfaces\nde repository do Domain", ".NET")
Rel(infraProj, db, "Lê e grava dados via\nEntity Framework Core", "EF Core / Npgsql")

@enduml
