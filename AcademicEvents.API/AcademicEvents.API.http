@host = http://localhost:5000
@token = paste_the_token_here

### Register user
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "name": "Maria Silva",
  "email": "maria@test.com",
  "password": "Password123!"
}

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "maria@test.com",
  "password": "Password123!"
}

### List events
GET {{host}}/api/events
Accept: application/json

### Create event
POST {{host}}/api/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "C# Workshop in Manaus",
  "description": "Hands-on workshop about ASP.NET Core",
  "startDate": "2026-06-10T09:00:00",
  "endDate": "2026-06-10T18:00:00",
  "location": "Block A - Room 201"
}